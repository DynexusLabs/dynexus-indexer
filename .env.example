# Comma-separated DYNEXUS package addresses (forge, swap, core); one if all share an account.
DYNEXUS_ADDRESSES=0x6e9d623d8aa35cf0453f96e2590d782bd19181e3f63758da443003b6049c44f6
DATABASE_URL=postgresql://dynexus:dynexus@localhost:5432/dynexus
API_ADDR=0.0.0.0:8080
# Restrict browser access in production, e.g. https://dynexus.netlify.app
CORS_ORIGIN=
RUST_LOG=info
# Host port for the compose Postgres (change if 5432 is taken)
POSTGRES_PORT=5432
