{
  "name": "dynexus-indexer",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "prepare": "lefthook install",
    "fmt": "cargo fmt --all && prettier --write \"**/*.{md,yml,yaml,json}\"",
    "lint": "cargo xclippy",
    "test": "cargo test --workspace",
    "secrets": "secretlint --maskSecrets \"**/*\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "secretlint": "13.0.7"
  }
}
