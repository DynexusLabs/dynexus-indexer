# Copy to deploy/oracle/.env (git-ignored) and fill in. Never commit the real file.

# Public hostname for the API. Without a domain, use the VM's IP via sslip.io,
# e.g. 129-146-12-34.sslip.io for IP 129.146.12.34.
DOMAIN=

# Generate with: openssl rand -hex 24   (hex only: no quotes, spaces or $)
POSTGRES_PASSWORD=

# Transaction Stream API key from https://geomi.dev
TRANSACTION_STREAM_API_KEY=

DYNEXUS_ADDRESSES=0x8ca69df6a4a839040bb86a15c4086732b7234bacfee3669e0941d9f477ffcb39

# First DYNEXUS publish on testnet. Only used on an empty database; afterwards the
# processor resumes from its checkpoint.
STARTING_VERSION=637759810

CORS_ORIGIN=https://dynexus-web.vercel.app
RUST_LOG=info
